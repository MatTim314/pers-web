---
// src/components/Navigation.astro
const links = [
  { href: "/nav/", text: "nav" },
  { href: "/notes/", text: "notes" },
];
---

<header>
  <nav>
    <a href="/" class="logo">Timar</a>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.text}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
