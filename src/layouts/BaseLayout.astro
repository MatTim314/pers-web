---
// src/layouts/BaseLayout.astro
import Navigation from "../components/Navigation.astro"; // Or make Navigation an Astro component
import Footer from "../components/Footer.svelte";

interface Props {
  title: string;
  description?: string; // Optional description for meta tags
}

const { title, description = "My Personal Website" } = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Add other common links/scripts here -->
    <title>{title} | Your Name</title>
  </head>
  <body>
    <Navigation /> {/* Use your improved Navigation component */}
    <main>
      <slot /> {/* Page content will be injected here */}
    </main>
  </body>
</html>
