		{"id":"351a5eb329821f22","type":"text","text":"# Packets\n- Fragmentation not allowed, only on end points\n- Path MTU discovery = figure out the need for fragmentation by sending a request and if it works it works if it doesnt fragment ","x":-829,"y":228,"width":489,"height":212},
		{"id":"e2406d53336d41b6","type":"text","text":"#  Neighbor discovery\nMade up of :\n- RS - router solicitation\n- RA - router advertisement\n- NS - neighbor S\n- NA - neighbor A\n- ICMP redirect\n\n","x":-291,"y":224,"width":491,"height":282},
		{"id":"2329a9e3239640d5","type":"text","text":"FF02:0:0:0:0:1:FF00::/104","x":380,"y":274,"width":279,"height":60},
