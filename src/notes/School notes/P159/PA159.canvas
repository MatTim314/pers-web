		{"id":"82567d224c8d2665","type":"file","file":"Ipv6 address abbreviation.png","x":-320,"y":-245,"width":400,"height":155},
		{"id":"88a5a64d3a0cbb0d","type":"text","text":"# Addresses:\n128 bits, omitting leading zeros, **first** zero group can be neglected\nTypes: \nunicast, \nmulticast ***ff00::***,\nanycast","x":-713,"y":-239,"width":253,"height":279},
		{"id":"bf0302dca6fb09af","type":"text","text":"# Why IPv6\n- Not enough IPv4 addresses\n- No security\n- No mobility\n- No real-time apps support\n\n- Simpler header\n- Extension header\n- Real-time\n- Security\n- Mobility - home agents\n- Autoconfiguration\n\n\n\n","x":-777,"y":-680,"width":377,"height":381},
		{"id":"4035b6aa4358edb5","type":"file","file":"Pasted image 20231209162440.png","x":-320,"y":-588,"width":400,"height":198},
