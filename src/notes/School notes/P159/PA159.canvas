		{"id":"38bf1143ea5aa534","type":"text","text":"IPv6 address\n2AC0:56:A319:15:022A:FFF:FE32:5ED1","x":716,"y":252,"width":398,"height":82},
		{"id":"e6558f1a41f84b0a","type":"text","text":"# Conversion of IPv6 to L2 address","x":449,"y":138,"width":535,"height":50},
		{"id":"60bf9058ad931287","type":"text","text":"FF02:0:0:0:0:1:FF32:5ED1:/104","x":520,"y":440,"width":409,"height":66},
		{"id":"49ff63d77b831130","type":"text","text":"# DAD\n*Imagine you're in a crowded room and someone shouts your name. If no one responds, you know your name is unique in that space.*\n\nSend NS with your address into the space. If no NA respond comes, your IPv6 is unique and you can keep it.","x":-291,"y":760,"width":496,"height":266},
